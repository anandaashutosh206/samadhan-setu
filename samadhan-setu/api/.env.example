# --- Database ---
# SQLite (zero setup, default). To use Postgres, change to:
# postgresql+psycopg2://user:password@localhost:5432/samadhan
DATABASE_URL=sqlite:///./samadhan.db

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- AI ---
AI_DEDUPE_THRESHOLD=0.62
# Optional LLM enrichment. Leave both blank to run fully offline (default).
LLM_PROVIDER=
LLM_API_KEY=

# --- Misc ---
ENV=development
APP_VERSION=1.0.0
